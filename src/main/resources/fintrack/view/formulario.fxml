<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" stylesheets="@estilo.css" xmlns="http://javafx.com" 
      xmlns:fx="http://javafx.com" fx:controller="fintrack.controller.FormularioController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Cadastrar Movimentação" styleClass="main-title" style="-fx-text-fill: #2b3e50;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Descrição:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDescription" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Valor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtValue" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Data:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDate" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Tipo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkIncome" text="Receita" onAction="#handleCheckIncome"/>
            <CheckBox fx:id="chkExpense" text="Despesa" onAction="#handleCheckExpense"/>
        </HBox>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancel"/>
        <Button text="Salvar" onAction="#saveTransaction" styleClass="btn-primary"/>
    </HBox>
</VBox>
